class Rectangle:
    def __init__(self, width, height):
        self.width = width
        self.height = height

    def set_width(self, width):
        self.width = width

    def set_height(self, height):
        self.height = height

    def get_area(self):
        # Area = width * height
        return self.width * self.height

    def get_perimeter(self):
        # Perimeter = 2 * (width + height)
        return 2 * (self.width + self.height)

    def get_diagonal(self):
        # Diagonal = sqrt(width^2 + height^2)
        return (self.width ** 2 + self.height ** 2) ** 0.5

    def get_picture(self):
        # Return specific validation message if sizes exceed 50 units
        if self.width > 50 or self.height > 50:
            return "Too big for picture."
        
        # Build the picture grid using standard loops / string multiplication
        picture = ""
        for _ in range(self.height):
            picture += "*" * self.width + "\n"
        return picture

    def get_amount_inside(self, shape):
        # Floor division handles calculation along both axes (no rotations)
        horizontal_fit = self.width // shape.width
        vertical_fit = self.height // shape.height
        return horizontal_fit * vertical_fit

    def __str__(self):
        return f"Rectangle(width={self.width}, height={self.height})"


class Square(Rectangle):
    def __init__(self, side):
        # Call the parent initializer mapping side to both width and height
        super().__init__(side, side)

    def set_side(self, side):
        # Sets width and height concurrently to keep properties square
        self.width = side
        self.height = side

    def set_width(self, width):
        # Override set_width to assign value to both dimensions
        self.set_side(width)

    def set_height(self, height):
        # Override set_height to assign value to both dimensions
        self.set_side(height)

    def __str__(self):
        return f"Square(side={self.width})"

